#!/bin/bash
# Auto-update for the repackaged Chrome Remote Desktop host. Run by
# chrome-remote-desktop-update.service:
#   install  (root, runs first) dnf install an RPM built by an earlier run,
#            once no session is active; independent of the network
#   build    (sandboxed DynamicUser) find the newest signed release tag in the
#            recipe repo, verify it, download that upstream version from
#            Google's signed apt repo and build it with the tagged recipe
set -euo pipefail

repo=https://dl.google.com/linux/chrome-remote-desktop/deb
key_url=https://dl.google.com/linux/linux_signing_key.pub
# Google Linux Packages Signing Authority primary key; signing subkeys rotate yearly.
google_fpr=EB4C1BFD4F042F6DDDCCEC917721F63BD38B4796
git_url=https://github.com/ArzykDev/chrome-remote-desktop-rpm
git_proto=(-c protocol.allow=never -c protocol.https.allow=always)
tag_re='^v([0-9][0-9.]*)-([0-9]+)$'
recipe=$(cd "$(dirname "$0")" && pwd)
signers=$recipe/allowed_signers
cache=${CACHE_DIRECTORY:-/var/cache/crd-update}
out=$cache/out

installed() {  # installed FORMAT: query the installed package, 0 if absent
    if rpm -q --quiet chrome-remote-desktop; then
        rpm -q --qf "$1" chrome-remote-desktop
    else
        echo 0
    fi
}

newer() {  # newer A B: A > B; arguments are validated version[-release] strings
    [[ $(rpm --eval "%{lua:print(rpm.vercmp('$1', '$2'))}") == 1 ]]
}

session_active() {
    # shortcut: only the multi-process host has a per-session peer_connection
    # process; a legacy chrome-remote-desktop@ session would go unnoticed.
    pgrep -f '^/opt/google/chrome-remote-desktop/chrome-remote-desktop-host --type=peer_connection' >/dev/null
}

stanza() {  # stanza PACKAGES VERSION|latest: "version filename sha256" of that version, or the newest
    awk -v want="$2" -v RS= '{
        p = v = f = s = ""
        n = split($0, l, "\n")
        for (i = 1; i <= n; i++) {
            if (l[i] ~ /^Package: /) p = substr(l[i], 10)
            if (l[i] ~ /^Version: /) v = substr(l[i], 10)
            if (l[i] ~ /^Filename: /) f = substr(l[i], 11)
            if (l[i] ~ /^SHA256: /) s = substr(l[i], 9)
        }
        # Same normalisation as build.sh, before sorting: RPM Version
        # cannot hold a Debian epoch or revision.
        sub(/^[0-9]+:/, "", v)
        sub(/-.*$/, "", v)
        if (p == "chrome-remote-desktop" && (want == "latest" || v == want)) print v, f, s
    }' "$1" | sort -V -k1,1 | tail -1
}

fetch_index() {  # fetch_index DIR: Google's Packages index, verified, into DIR/Packages
    export GNUPGHOME=$1/gnupg
    mkdir -m700 "$GNUPGHOME"
    curl -fsS --proto =https -o "$1/key.pub" "$key_url"
    gpg -q --batch --import "$1/key.pub"
    gpg -q --batch --export "$google_fpr" > "$1/google.gpg"
    [[ -s $1/google.gpg ]] || { echo "pinned Google key $google_fpr not in $key_url" >&2; exit 1; }

    curl -fsS --proto =https -o "$1/Release" "$repo/dists/stable/Release"
    curl -fsS --proto =https -o "$1/Release.gpg" "$repo/dists/stable/Release.gpg"
    gpgv -q --keyring "$1/google.gpg" "$1/Release.gpg" "$1/Release"

    local packages_sha
    packages_sha=$(awk '$3 == "main/binary-amd64/Packages" && length($1) == 64 { print $1 }' "$1/Release")
    [[ $packages_sha =~ ^[0-9a-f]{64}$ ]] || { echo "no SHA256 for Packages in Release" >&2; exit 1; }
    curl -fsS --proto =https -o "$1/Packages" "$repo/dists/stable/main/binary-amd64/Packages"
    echo "$packages_sha  $1/Packages" | sha256sum -c --quiet
}

fetch_deb() {  # fetch_deb DIR VERSION|latest: after fetch_index, DIR/crd.deb; sets deb_version
    local filename deb_sha
    read -r deb_version filename deb_sha < <(stanza "$1/Packages" "$2") || true
    [[ $deb_version =~ ^[0-9][0-9.]*$ ]] || { echo "no valid $2 version in Packages: $deb_version" >&2; exit 1; }
    [[ $filename =~ ^pool/main/c/chrome-remote-desktop/chrome-remote-desktop_[A-Za-z0-9.+~:-]+_amd64\.deb$ ]] \
        || { echo "unexpected filename: $filename" >&2; exit 1; }
    [[ $deb_sha =~ ^[0-9a-f]{64}$ ]] || { echo "no SHA256 for $filename" >&2; exit 1; }
    curl -fsS --proto =https -o "$1/crd.deb" "$repo/$filename"
    echo "$deb_sha  $1/crd.deb" | sha256sum -c --quiet
}

pick_tag() {  # pick_tag < ls-remote output: newest well-formed release tag, empty if none
    local ref tag best=
    while read -r _ ref; do
        tag=${ref#refs/tags/}
        # Before newer(): ref names come from the network and newer() evaluates them as Lua.
        [[ $tag =~ $tag_re ]] || continue
        if [[ -z $best ]] || newer "${tag#v}" "${best#v}"; then best=$tag; fi
    done
    echo "$best"
}

verify_tag() {  # verify_tag CLONE TAG: signed by a key in $signers, and signed under the name TAG
    git -C "$1" -c gpg.format=ssh -c gpg.ssh.allowedSignersFile="$signers" -c gpg.minTrustLevel=fully \
        verify-tag "$2" || return 1
    # The signature covers the name inside the tag object, not the ref it is published under.
    [[ $(git -C "$1" cat-file tag "$2" | sed -n '/^$/q; s/^tag //p') == "$2" ]] \
        || { echo "$2 points at a tag object signed under another name" >&2; return 1; }
}

build() {
    work=$(mktemp -d)  # global: the EXIT trap runs after build() returns
    trap 'rm -rf "$work"' EXIT
    export HOME=$work

    local refs tag version release current
    if ! refs=$(git "${git_proto[@]}" ls-remote --tags --refs "$git_url"); then
        echo "cannot list tags at $git_url; retrying next run"
        return
    fi
    tag=$(pick_tag <<< "$refs")
    [[ $tag ]] || { echo "no release tags at $git_url"; return; }
    [[ $tag =~ $tag_re ]]
    version=${BASH_REMATCH[1]} release=${BASH_REMATCH[2]}

    current=$(installed '%{VERSION}-%{RELEASE}')
    if ! newer "$version-$release" "$current"; then
        echo "up to date ($current, newest tag $tag)"
        rm -rf "$out"  # drop a deferred build that a manual install superseded
        return
    fi
    if compgen -G "$out/chrome-remote-desktop-$version-$release.*.rpm" >/dev/null; then
        echo "$tag already built, waiting for install"
        return
    fi

    git "${git_proto[@]}" clone -q --depth 1 --branch "$tag" "$git_url" "$work/src"
    # Fail loudly rather than fall back to an older tag: an unverifiable newest tag needs a human.
    verify_tag "$work/src" "$tag" || { echo "refusing $tag: not signed by a key in $signers" >&2; exit 1; }

    fetch_index "$work"
    if [[ -z $(stanza "$work/Packages" "$version") ]]; then
        echo "approved $version is no longer in Google's index; waiting for a newer tag"
        return
    fi
    echo "building $tag (installed: $current)"
    fetch_deb "$work" "$version"
    rm -rf "$out"
    RELEASE=$release "$work/src/build.sh" "$work/crd.deb" "$out"
}

install() {
    local rpm
    rpm=$(compgen -G "$out/chrome-remote-desktop-*.rpm" | sort -V | tail -1) || { echo "nothing to install"; return; }
    if ! newer "$(rpm -qp --qf '%{VERSION}-%{RELEASE}' "$rpm")" "$(installed '%{VERSION}-%{RELEASE}')"; then
        echo "discarding ${rpm##*/}: not newer than the installed package"
        rm -rf "$out"
        return
    fi
    if ! rpm -qpl "$rpm" | grep -qxF "$signers"; then
        # Built by a pre-tag updater; installing it would bring that updater back.
        echo "discarding ${rpm##*/}: built from a recipe without release-tag verification"
        rm -rf "$out"
        return
    fi
    if session_active; then
        echo "session active, deferring install of ${rpm##*/}"
        return
    fi
    echo "installing ${rpm##*/}"
    # -C skips the metadata refresh, keeping the gap after the session check short.
    if ! dnf install -y -C --setopt=install_weak_deps=False "$rpm"; then
        if session_active; then
            echo "session started, deferring install of ${rpm##*/}"
            return
        fi
        dnf install -y --setopt=install_weak_deps=False "$rpm"
    fi
    rm -rf "$out"
}

[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0  # sourced by tests

case ${1:-} in
    install) install ;;
    build) build ;;
    *) echo "usage: $0 install|build" >&2; exit 2 ;;
esac
